# ===== 감시할 네이버 카페 게시판 =====
# 카페 주소(예: https://cafe.naver.com/스토어이름)에서 게시판을 연 뒤,
# 게시판 글 목록 페이지의 주소창에서 아래 두 숫자를 찾으세요.
#   clubid : 카페 고유 번호 (예: 12345678)
#   menuid : 게시판 번호 (예: 25)
# 찾는 방법은 README.md 참고.
NAVER_CLUB_ID=
NAVER_MENU_ID=

# 확인 주기(초). 기본 60초. 너무 짧게 하면 차단될 수 있어요.
POLL_INTERVAL=60

# ===== 알림 받는 방법 선택: sms 또는 telegram =====
NOTIFY_METHOD=telegram

# ----- (A) 텔레그램으로 받을 때 (무료, 추천) -----
# 1) 텔레그램에서 @BotFather 검색 → /newbot 으로 봇 생성 → 토큰 복사
# 2) 만든 봇과 대화 시작 후 아무 메시지나 전송
# 3) https://api.telegram.org/bot<토큰>/getUpdates 접속해서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- (B) 문자(SMS)로 받을 때 (유료, 솔라피/CoolSMS) -----
# https://solapi.com 가입 → API Key/Secret 발급, 발신번호 사전 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=01000000000
SMS_TO=01000000000
