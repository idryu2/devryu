# ===== 감시할 네이버 카페 게시판 =====
# 카페 고유 번호(clubid)와 게시판 번호(menuid).
# 보내주신 URL(.../cafes/20486145/menus/0?q=카리20&ta=SUBJECT) 기준으로 미리 채웠습니다.
#   - clubid 20486145  : 이 카페
#   - menuid 0         : 전체글(모든 게시판). 특정 게시판만 보려면 그 게시판 번호로 변경.
NAVER_CLUB_ID=20486145
NAVER_MENU_ID=0

# ===== (선택) 제목 키워드 필터 =====
# 제목에 이 단어가 들어간 글만 알림. 여러 개면 쉼표로 구분. 비우면 모든 새 글 알림.
# 보내주신 검색(ta=SUBJECT, q=카리20) 기준으로 "카리20" 을 넣었습니다.
NAVER_KEYWORD=카리20

# ===== (선택) 비공개(회원전용) 카페일 때만 =====
# 로그아웃/시크릿창에서 글 목록이 안 보이는 카페면, 로그인 상태의 브라우저
# 개발자도구(F12) > Network 에서 요청 헤더의 Cookie 값을 통째로 붙여넣으세요.
# 전체공개 카페면 비워두면 됩니다.
NAVER_COOKIE=

# 확인 주기(초). 기본 60초. 너무 짧게 하면 차단될 수 있어요.
POLL_INTERVAL=60

# ===== 알림 받는 방법 선택: telegram(무료, 추천) 또는 sms(유료) =====
NOTIFY_METHOD=telegram

# ----- (A) 텔레그램으로 받을 때 (무료, 추천) -----
# 1) 텔레그램에서 @BotFather 검색 → /newbot 으로 봇 생성 → 토큰 복사
# 2) 만든 봇과 대화 시작 후 아무 메시지나 전송
# 3) https://api.telegram.org/bot<토큰>/getUpdates 접속해서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- (B) 문자(SMS)로 받을 때 (유료, 솔라피/CoolSMS) -----
# https://solapi.com 가입 → API Key/Secret 발급, 발신번호 사전 등록 필요
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=01000000000
SMS_TO=01000000000
