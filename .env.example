# ── 처방 CDSS 시연 시스템 환경변수 템플릿 ──
# cp .env.example .env 후 그대로 사용하면 LLM 키 없이 mock으로 전체 데모가 동작합니다.

# ── Database (PostgreSQL 15 + pgvector) ──
POSTGRES_USER=cdss
POSTGRES_PASSWORD=cdss
POSTGRES_DB=cdss
# 로컬(컨테이너 밖) 개발용. docker compose는 host를 'db'로 자동 덮어씁니다.
DATABASE_URL=postgresql+psycopg://cdss:cdss@localhost:5432/cdss

# ── LLM 공급자 ──
# anthropic | openai | mock
# 키가 비어 있으면 어떤 값이든 자동으로 mock으로 폴백합니다.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── RAG 임베딩 ──
# 키가 없으면 결정론적 로컬 해시 임베딩(데모용)으로 폴백합니다.
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=1536

# ── 앱 설정 ──
APP_ENV=demo
